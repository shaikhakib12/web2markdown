{
  "name": "pagescribe",
  "version": "1.0.0",
  "description": "Turn any webpage into clean, text-only Markdown. Privacy-first, local Chrome Extension.",
  "main": "scripts/converter.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/shaikhakib12/web2markdown.git"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build:libs": "node scripts/bundle-libs.js",
    "build:assets": "node scripts/generate-store-assets.js",
    "verify": "node scripts/verify-manifest.js",
    "package": "node scripts/package-extension.js"
  },
  "keywords": [
    "chrome-extension",
    "markdown",
    "web-to-markdown",
    "readability",
    "turndown",
    "privacy-first",
    "text-only",
    "manifest-v3"
  ],
  "author": "PageScribe Contributors",
  "license": "MIT",
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "archiver": "^8.0.0",
    "jsdom": "^26.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
