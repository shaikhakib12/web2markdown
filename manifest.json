{
  "manifest_version": 3,
  "name": "PageScribe - Clean Web to Markdown",
  "version": "1.0.0",
  "description": "Turn any webpage into clean, text-only Markdown with one click. Privacy-first, 100% local, no images, ads, or trackers.",
  "author": "PageScribe Contributors",
  "homepage_url": "https://github.com/shaikhakib12/web2markdown",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "downloads"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PageScribe - Convert to Markdown"
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
